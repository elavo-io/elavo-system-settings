<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- One action per helper command. pkexec matches the helper's path and
     its first argument, so each command has its own message. -->
<policyconfig>
  <vendor>Elavo</vendor>
  <vendor_url>https://github.com/elavo-io</vendor_url>
  <icon_name>io.elavo.SystemSettings</icon_name>

  <action id="io.elavo.SystemSettings.update-upgrade">
    <description>Install a system update</description>
    <message>Authentication is required to install a system update.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">upgrade</annotate>
  </action>

  <action id="io.elavo.SystemSettings.update-download">
    <description>Download a system update</description>
    <message>Authentication is required to download a system update.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">download</annotate>
  </action>

  <action id="io.elavo.SystemSettings.update-install">
    <description>Install a downloaded system update</description>
    <message>Authentication is required to install a downloaded system update.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">install</annotate>
  </action>

  <action id="io.elavo.SystemSettings.update-upgrade-anyway">
    <description>Remove extra software and install a system update</description>
    <message>Authentication is required to remove extra software and install a system update.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">upgrade-anyway</annotate>
  </action>

  <action id="io.elavo.SystemSettings.update-auto">
    <description>Change automatic system updates</description>
    <message>Authentication is required to change automatic system updates.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">auto</annotate>
  </action>

  <action id="io.elavo.SystemSettings.update-switch">
    <description>Change the update channel</description>
    <message>Authentication is required to change the update channel.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">switch</annotate>
  </action>

  <action id="io.elavo.SystemSettings.update-rollback">
    <description>Go back to the previous system version</description>
    <message>Authentication is required to go back to the previous system version.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">rollback</annotate>
  </action>

  <action id="io.elavo.SystemSettings.power-lid">
    <description>Change what closing the lid does</description>
    <message>Authentication is required to change what closing the lid does.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">lid</annotate>
  </action>

  <action id="io.elavo.SystemSettings.wifi-driver">
    <description>Turn on a hardware driver</description>
    <message>Authentication is required to turn on a hardware driver.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">wifi-driver</annotate>
  </action>

  <action id="io.elavo.SystemSettings.switch-nvidia">
    <description>Switch to the NVIDIA system image</description>
    <message>Authentication is required to switch to the NVIDIA system image.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">switch-nvidia</annotate>
  </action>

  <action id="io.elavo.SystemSettings.switch-elavo">
    <description>Switch back to the standard system image</description>
    <message>Authentication is required to switch back to the standard system image.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">switch-elavo</annotate>
  </action>

  <action id="io.elavo.SystemSettings.login-window">
    <description>Change what the login window shows</description>
    <message>Authentication is required to change what the login window shows.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">login-window</annotate>
  </action>
  <action id="io.elavo.SystemSettings.domain-admins">
    <description>Choose which directory groups administer this computer</description>
    <message>Authentication is required to choose which directory groups administer this computer.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/elavo-system-settings-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">domain-admins</annotate>
  </action>

  <!-- CheckAuthorization only: not a helper command. Authorizing this
       action also authorizes realmd's join and login-policy actions, so
       an Active Directory join asks for a password once. -->
  <action id="io.elavo.SystemSettings.domain-join">
    <description>Join this computer to a directory</description>
    <message>Authentication is required to join this computer to a directory.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.imply">org.freedesktop.realmd.configure-realm org.freedesktop.realmd.login-policy</annotate>
  </action>
</policyconfig>
